# Node
NODE_ENV=development

# Database
DATABASE_URL="postgresql://smart:1@localhost:5432/e_commerce_full?schema=public"
DATABASE_URL_LANDLORD="postgresql://smart:1@localhost:5432/e_commerce_full?schema=public"
# Superuser connection used only by `pnpm --filter @ecf/db db:init` (create roles, apply RLS).
# Leave unset to fall back to DATABASE_URL.
DATABASE_SUPERUSER_URL=""
# Passwords applied to the ecf_app / ecf_landlord roles. Generate strong
# random values (>=32 chars) for production and store in your secret manager.
ECF_APP_PASSWORD="dev_ecf_app_pw"
ECF_LANDLORD_PASSWORD="dev_ecf_landlord_pw"

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_BULL_URL="redis://localhost:6379/1"

# API
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"
# Fallback origins used when API_CORS_ORIGINS is empty (dev convenience).
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Auth - RS256 PEM keys (multi-line via \n or base64). Generate with scripts/generate-jwt-keys.ts
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="ecf-api"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Storage (MinIO dev)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="ecf-media"
S3_FORCE_PATH_STYLE=true

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
