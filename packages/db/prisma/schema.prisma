// =============================================================================
// ECF — multi-tenant e-commerce Prisma schema
// PostgreSQL 16 + RLS. All tenant-scoped tables carry `tenantId` + are guarded
// by Row-Level Security policies in prisma/rls.sql (applied post-migrate).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum TenantStatus {
  trial
  active
  suspended
  cancelled
  deleted
}

enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  draft
  pending_payment
  payment_success
  payment_failed
  preparing
  shipped
  delivered
  closed
  cancelled
  refund_requested
  refunded
  partial_refunded
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum RefundReasonCategory {
  DAMAGED
  WRONG_ITEM
  SIZE_ISSUE
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  pending
  publishing
  published
  failed
}

enum JwtAudience {
  customer
  staff
  landlord
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

// =============================================================================
// GLOBAL (no RLS)
// =============================================================================

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  subdomain    String       @unique
  name         String
  status       TenantStatus @default(trial)
  planId       String       @db.Uuid
  ownerUserId  String?      @db.Uuid
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("tenants")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  features  Json     @default("{}")
  limits    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants   Tenant[]

  @@map("plans")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  phone           String?
  firstName       String?
  lastName        String?
  mfaEnabled      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantMembers   TenantMember[]
  customers       Customer[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model LandlordUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("landlord_users")
}

// =============================================================================
// TENANT-SCOPED (RLS enforced)
// =============================================================================

model TenantMember {
  tenantId   String    @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id])

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// null for system-wide roles (OWNER, ADMIN, PRODUCT_MANAGER, ORDER_OPERATOR, VIEWER)
  tenantId    String?  @db.Uuid
  code        String
  name        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TenantMember[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  /// null for landlord and for pre-tenant-selection customer tokens
  tenantId       String?   @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  audience       JwtAudience
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?   @db.Uuid
  issuedIp       String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ----------- Catalog ---------------------------------------------------------

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  slug      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("brands")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  parentId  String?  @db.Uuid
  slug      String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  CategoryProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  slug        String
  title       String
  description String?
  brandId     String?       @db.Uuid
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand       Brand?        @relation(fields: [brandId], references: [id])
  options     ProductOption[]
  variants    ProductVariant[]
  categories  CategoryProduct[]
  media       MediaAsset[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
  @@map("products")
}

model ProductOption {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  productId String  @db.Uuid
  name      String
  position  Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@index([tenantId, productId])
  @@map("product_options")
}

model ProductOptionValue {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  productOptionId String  @db.Uuid
  value           String
  position        Int     @default(0)

  option          ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, productOptionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  productId           String   @db.Uuid
  sku                 String
  priceMinorUnits     BigInt
  compareAtMinorUnits BigInt?
  currency            String   @db.Char(3)
  stockOnHand         Int      @default(0)
  stockReserved       Int      @default(0)
  weightGrams         Int?
  optionValue1Id      String?  @db.Uuid
  optionValue2Id      String?  @db.Uuid
  optionValue3Id      String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model CategoryProduct {
  tenantId   String @db.Uuid
  categoryId String @db.Uuid
  productId  String @db.Uuid
  position   Int    @default(0)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([tenantId, categoryId, productId])
  @@map("category_products")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  productId String?  @db.Uuid
  url       String
  mime      String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@map("media_assets")
}

// ----------- Customers -------------------------------------------------------

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String?  @db.Uuid
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  acceptsMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses        CustomerAddress[]
  orders           Order[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerId   String   @db.Uuid
  fullName     String
  phone        String?
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String
  country      String   @db.Char(2)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

model ConsentRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  customerId String?  @db.Uuid
  type       String
  version    String
  ipAddress  String?
  userAgent  String?
  givenAt    DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, customerId])
  @@map("consent_records")
}

// ----------- Orders / Outbox / Audit ----------------------------------------

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @db.Uuid
  orderNumber       String
  customerId        String?     @db.Uuid
  guestEmail        String?
  status            OrderStatus @default(pending_payment)
  subtotalMinor     BigInt
  taxMinor          BigInt      @default(0)
  shippingMinor     BigInt      @default(0)
  discountMinor     BigInt      @default(0)
  totalMinor        BigInt
  currency          String      @db.Char(3)
  paymentProvider   String      @default("stub")
  paymentRef        String?
  /// True while the order is an admin-created draft (not yet placed by a customer).
  /// Drafts are excluded from customer-facing queries + outbox events until converted.
  isDraft           Boolean     @default(false) @map("is_draft")
  /// Coupon applied during checkout (null when none). Redemption row is written on complete.
  couponCode        String?     @map("coupon_code")
  couponId          String?     @db.Uuid @map("coupon_id")
  placedAt          DateTime    @default(now())
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer          Customer?      @relation(fields: [customerId], references: [id])
  lines             OrderLine[]
  statusHistory     OrderStatusHistory[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, placedAt])
  @@index([tenantId, customerId])
  @@index([tenantId, isDraft])
  @@map("orders")
}

model OrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  orderId         String   @db.Uuid
  productId       String?  @db.Uuid
  variantId       String?  @db.Uuid
  sku             String
  titleSnapshot   String
  priceMinorUnits BigInt
  quantity        Int
  totalMinorUnits BigInt
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  orderId    String      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorUserId String?    @db.Uuid
  note       String?
  occurredAt DateTime    @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_status_history")
}

model InventoryReservation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  variantId  String   @db.Uuid
  orderId    String?  @db.Uuid
  sessionId  String?
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([tenantId, variantId])
  @@map("inventory_reservations")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  aggregateType String
  aggregateId   String       @db.Uuid
  eventType     String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  tenantId     String   @db.Uuid
  consumerName String
  eventId      String   @db.Uuid
  processedAt  DateTime @default(now())

  @@id([tenantId, consumerName, eventId])
  @@map("processed_events")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  actorUserId  String?  @db.Uuid
  eventType    String
  resourceType String?
  resourceId   String?
  ipAddress    String?  @db.Inet
  userAgent    String?
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, eventType, occurredAt])
  @@map("audit_events")
}

// ----------- Coupons / Promotions (FSD 4.4.3 + 15) --------------------------

model Coupon {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @db.Uuid
  code                  String     @db.VarChar(64)
  type                  CouponType
  /// PERCENT: basis points (1000 = %10). FIXED: minor units. FREE_SHIPPING: 0.
  value                 BigInt
  /// Minor-unit minimum cart subtotal required for the coupon to apply.
  minimumAmount         BigInt?
  /// Cap on absolute discount in minor units (defends against unbounded percent deals).
  maximumDiscount       BigInt?
  startsAt              DateTime?
  endsAt                DateTime?
  /// Global usage limit across all customers.
  usageLimit            Int?
  /// Per-customer usage limit.
  usageLimitPerCustomer Int?
  usageCount            Int        @default(0)
  stackable             Boolean    @default(false)
  isActive              Boolean    @default(true)
  /// When any of these arrays is non-empty the coupon is scoped to that subset.
  customerGroupIds      String[]   @default([]) @db.Uuid
  categoryIds           String[]   @default([]) @db.Uuid
  productIds            String[]   @default([]) @db.Uuid
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  redemptions           CouponRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId, code])
  @@index([tenantId, isActive, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  couponId        String   @db.Uuid
  orderId         String   @db.Uuid
  customerId      String?  @db.Uuid
  discountApplied BigInt
  createdAt       DateTime @default(now())

  coupon          Coupon   @relation(fields: [couponId], references: [id])

  @@index([tenantId, couponId])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@map("coupon_redemptions")
}

// ----------- Refunds (FSD 5.3.4) --------------------------------------------

model RefundRequest {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  orderId         String                @db.Uuid
  customerId      String?               @db.Uuid
  reason          String
  reasonCategory  RefundReasonCategory
  requestedAmount BigInt
  status          RefundRequestStatus   @default(PENDING)
  /// Array of { orderItemId, qty, amount } — Json for flexible partial-return support.
  itemSelections  Json
  rejectionReason String?
  approvedBy      String?               @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  refunds         Refund[]

  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("refund_requests")
}

model Refund {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  orderId         String   @db.Uuid
  refundRequestId String   @db.Uuid
  amount          BigInt
  gatewayRefundId String?
  /// "stub_completed" in MVP — no real gateway integration yet.
  status          String   @default("stub_completed")
  note            String?
  createdBy       String?  @db.Uuid
  createdAt       DateTime @default(now())

  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, refundRequestId])
  @@map("refunds")
}

// ----------- Payment / Shipping providers (FSD 4.5.3 / 4.5.4 / 5.6) ---------

model PaymentMethodConfig {
  tenantId     String   @map("tenant_id") @db.Uuid
  id           String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerCode String   @map("provider_code")
  displayName  String   @map("display_name")
  description  String?
  config       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  minAmount    BigInt?  @map("min_amount")
  maxAmount    BigInt?  @map("max_amount")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@id([tenantId, id])
  @@unique([tenantId, providerCode])
  @@map("payment_method_configs")
}

model Payment {
  tenantId      String        @map("tenant_id") @db.Uuid
  id            String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  providerCode  String        @map("provider_code")
  providerRef   String?       @map("provider_ref")
  amount        BigInt
  currency      String        @default("TRY") @db.VarChar(3)
  status        PaymentStatus @default(PENDING)
  failureReason String?       @map("failure_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@id([tenantId, id])
  @@index([tenantId, orderId])
  @@map("payments")
}

model ShippingMethodConfig {
  tenantId              String   @map("tenant_id") @db.Uuid
  id                    String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerCode          String   @map("provider_code")
  code                  String
  displayName           String   @map("display_name")
  description           String?
  config                Json     @default("{}")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  estimatedDaysMin      Int?     @map("estimated_days_min")
  estimatedDaysMax      Int?     @map("estimated_days_max")
  freeShippingThreshold BigInt?  @map("free_shipping_threshold")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@id([tenantId, id])
  @@unique([tenantId, providerCode, code])
  @@map("shipping_method_configs")
}

model Shipment {
  tenantId       String         @map("tenant_id") @db.Uuid
  id             String         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  providerCode   String         @map("provider_code")
  trackingNumber String?        @map("tracking_number")
  trackingUrl    String?        @map("tracking_url")
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@id([tenantId, id])
  @@index([tenantId, orderId])
  @@index([tenantId, trackingNumber])
  @@map("shipments")
}

// ----------- Tenant settings (FSD 4.3 + branding) ----------------------------

model TenantSettings {
  tenantId        String   @id @map("tenant_id") @db.Uuid
  storeName       String   @map("store_name")
  storeEmail      String   @map("store_email")
  storePhone      String?  @map("store_phone")
  storeAddress    Json?    @map("store_address")
  currency        String   @default("TRY") @db.VarChar(3)
  defaultLanguage String   @default("tr") @map("default_language") @db.VarChar(10)
  timezone        String   @default("Europe/Istanbul")
  weightUnit      String   @default("kg") @map("weight_unit")
  dimensionUnit   String   @default("cm") @map("dimension_unit")
  kvkkContact     String?  @map("kvkk_contact")
  taxNumber       String?  @map("tax_number")
  legalName       String?  @map("legal_name")
  logoMediaId     String?  @map("logo_media_id") @db.Uuid
  faviconMediaId  String?  @map("favicon_media_id") @db.Uuid
  primaryColor    String?  @default("#0ea5e9") @map("primary_color")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}
