// =============================================================================
// ECF — multi-tenant e-commerce Prisma schema
// PostgreSQL 16 + RLS. All tenant-scoped tables carry `tenantId` + are guarded
// by Row-Level Security policies in prisma/rls.sql (applied post-migrate).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum TenantStatus {
  trial
  active
  suspended
  cancelled
  deleted
}

enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  pending_payment
  payment_success
  preparing
  shipped
  delivered
  closed
  cancelled
  refund_requested
  refunded
}

enum OutboxStatus {
  pending
  publishing
  published
  failed
}

enum JwtAudience {
  customer
  staff
  landlord
}

// =============================================================================
// GLOBAL (no RLS)
// =============================================================================

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  subdomain    String       @unique
  name         String
  status       TenantStatus @default(trial)
  planId       String       @db.Uuid
  ownerUserId  String?      @db.Uuid
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("tenants")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  features  Json     @default("{}")
  limits    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants   Tenant[]

  @@map("plans")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  phone           String?
  firstName       String?
  lastName        String?
  mfaEnabled      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantMembers   TenantMember[]
  customers       Customer[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model LandlordUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("landlord_users")
}

// =============================================================================
// TENANT-SCOPED (RLS enforced)
// =============================================================================

model TenantMember {
  tenantId   String    @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id])

  @@id([tenantId, userId])
  @@index([tenantId])
  @@map("tenant_members")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// null for system-wide roles (OWNER, ADMIN, PRODUCT_MANAGER, ORDER_OPERATOR, VIEWER)
  tenantId    String?  @db.Uuid
  code        String
  name        String
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TenantMember[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  /// null for landlord and for pre-tenant-selection customer tokens
  tenantId       String?   @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  audience       JwtAudience
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?   @db.Uuid
  issuedIp       String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ----------- Catalog ---------------------------------------------------------

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  slug      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("brands")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  parentId  String?  @db.Uuid
  slug      String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  CategoryProduct[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  slug        String
  title       String
  description String?
  brandId     String?       @db.Uuid
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand       Brand?        @relation(fields: [brandId], references: [id])
  options     ProductOption[]
  variants    ProductVariant[]
  categories  CategoryProduct[]
  media       MediaAsset[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
  @@map("products")
}

model ProductOption {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  productId String  @db.Uuid
  name      String
  position  Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@index([tenantId, productId])
  @@map("product_options")
}

model ProductOptionValue {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  productOptionId String  @db.Uuid
  value           String
  position        Int     @default(0)

  option          ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, productOptionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  productId           String   @db.Uuid
  sku                 String
  priceMinorUnits     BigInt
  compareAtMinorUnits BigInt?
  currency            String   @db.Char(3)
  stockOnHand         Int      @default(0)
  stockReserved       Int      @default(0)
  weightGrams         Int?
  optionValue1Id      String?  @db.Uuid
  optionValue2Id      String?  @db.Uuid
  optionValue3Id      String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model CategoryProduct {
  tenantId   String @db.Uuid
  categoryId String @db.Uuid
  productId  String @db.Uuid
  position   Int    @default(0)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([tenantId, categoryId, productId])
  @@map("category_products")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  productId String?  @db.Uuid
  url       String
  mime      String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@map("media_assets")
}

// ----------- Customers -------------------------------------------------------

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String?  @db.Uuid
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  acceptsMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses        CustomerAddress[]
  orders           Order[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerId   String   @db.Uuid
  fullName     String
  phone        String?
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String
  country      String   @db.Char(2)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

model ConsentRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  customerId String?  @db.Uuid
  type       String
  version    String
  ipAddress  String?
  userAgent  String?
  givenAt    DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, customerId])
  @@map("consent_records")
}

// ----------- Orders / Outbox / Audit ----------------------------------------

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @db.Uuid
  orderNumber       String
  customerId        String?     @db.Uuid
  guestEmail        String?
  status            OrderStatus @default(pending_payment)
  subtotalMinor     BigInt
  taxMinor          BigInt      @default(0)
  shippingMinor     BigInt      @default(0)
  discountMinor     BigInt      @default(0)
  totalMinor        BigInt
  currency          String      @db.Char(3)
  paymentProvider   String      @default("stub")
  paymentRef        String?
  placedAt          DateTime    @default(now())
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer          Customer?      @relation(fields: [customerId], references: [id])
  lines             OrderLine[]
  statusHistory     OrderStatusHistory[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, placedAt])
  @@index([tenantId, customerId])
  @@map("orders")
}

model OrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  orderId         String   @db.Uuid
  productId       String?  @db.Uuid
  variantId       String?  @db.Uuid
  sku             String
  titleSnapshot   String
  priceMinorUnits BigInt
  quantity        Int
  totalMinorUnits BigInt
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  orderId    String      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorUserId String?    @db.Uuid
  note       String?
  occurredAt DateTime    @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_status_history")
}

model InventoryReservation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  variantId  String   @db.Uuid
  orderId    String?  @db.Uuid
  sessionId  String?
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([tenantId, variantId])
  @@map("inventory_reservations")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  aggregateType String
  aggregateId   String       @db.Uuid
  eventType     String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  tenantId     String   @db.Uuid
  consumerName String
  eventId      String   @db.Uuid
  processedAt  DateTime @default(now())

  @@id([tenantId, consumerName, eventId])
  @@map("processed_events")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  actorUserId  String?  @db.Uuid
  eventType    String
  resourceType String?
  resourceId   String?
  ipAddress    String?  @db.Inet
  userAgent    String?
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, eventType, occurredAt])
  @@map("audit_events")
}
